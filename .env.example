# Copy this file to .env and fill in real values.
# Using a personal Gmail account with 2FA enabled requires an App Password (16 characters, no spaces).
# Generate one at: Google Account -> Security -> App passwords -> Select "Mail" + "Other" (or your device) -> Generate.

# Option 1: Gmail service (simplest)
EMAIL_SERVICE=gmail
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
FROM_EMAIL=Santa Lotto <your_gmail_address@gmail.com>
EMAIL_SERVER_PORT=4000

# Option 2 (leave commented unless using custom SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_username@example.com
# SMTP_PASS=your_smtp_password
# FROM_EMAIL=Santa Lotto <your_username@example.com>
# EMAIL_SERVER_PORT=4000

# OPTIONAL: set NODE_ENV=development for easier logs
NODE_ENV=development

